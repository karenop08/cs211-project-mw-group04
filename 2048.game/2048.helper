#include <iostream> //allows the program to display text
#include <random> //Provides random number tools.
#include <iomanip> //Helps format the game board.
using namespace std; 

// This function moves numbers together and combines matching tiles.
bool process_line(int line[5], int& score) 
//int linw[5] means we are working with 5 numbers in one row or column*
//int& score means we can update the player's score inside this function*
{
    int original[5]; // creates an array that holds 5 numbers*

    // Save the original line so we can compare it later.
    for (int i = 0; i < 5; i++)
    {
        original[i] = line[i]; //copies the original numbers*
    }

    int temp[5] = {0, 0, 0, 0, 0}; //five empty spaces
    //use these spaces to arrange the number
    int position = 0; //tells the comp where to put the next number

    // Step 1: Move all nonzero numbers together.
    //this code removes the empty spaces between numbers
    for (int i = 0; i < 5; i++)
    {
        if (line[i] != 0) 
        {
            temp[position] = line[i];
            position++;
        }
    }

    // Step 2: Combine matching numbers.
    for (int i = 0; i < 4; i++)
    //checks position 0 through 3
    {
        if (temp[i] != 0 && temp[i] == temp[i + 1])
        {
            temp[i] = temp[i] * 2;

            // Add the new tile value to the score.
            score += temp[i];

            // Clear the tile that was combined.
            temp[i + 1] = 0;

            // Skip the newly combined tile.
            i++;
        }
    }

    // Step 3: Move numbers together again after merging.
    int result[5] = {0, 0, 0, 0, 0};
    position = 0;

    for (int i = 0; i < 5; i++)
    {
        if (temp[i] != 0)
        {
            result[position] = temp[i];
            position++;
        }
    }

    // Check whether anything actually changed.
    bool changed = false;

    for (int i = 0; i < 5; i++)
    {
        line[i] = result[i];

        if (original[i] != result[i])
        {
            changed = true;
        }
    }

    return changed;
}


// MOVE LEFT
bool move_left(int board[][5], int numrows, int& score)
{
    bool changed = false;

    for (int r = 0; r < numrows; r++)
    {
        if (process_line(board[r], score)) //process line is designed to move numbers to the left
        {
            changed = true;
        }
    }

    return changed;
}


// MOVE RIGHT
bool move_right(int board[][5], int numrows, int& score)
{
    bool changed = false;

    for (int r = 0; r < numrows; r++)
    {
        int line[5];  //creates a temp row to hold five numbers

        // Read the row backwards.
        for (int c = 0; c < 5; c++)
        {
            line[c] = board[r][4 - c]; // read the row backwards
        }

        if (process_line(line, score))
        {
            changed = true;   // it slides and combines numbers to the left
        }

        // Put the row back backwards.
        for (int c = 0; c < 5; c++)
        {
            board[r][4 - c] = line[c];  //this puts the number back into the original board, in reverse order
        }
    }

    return changed;
}


// MOVE UP
bool move_up(int board[][5], int numrows, int& score)
{
    bool changed = false;

    for (int c = 0; c < 5; c++) // tells the computer to check each of the five columns
    {
        int line[5]; //create a temp array to hold one column

        // Read the column from top to bottom.
        for (int r = 0; r < numrows; r++)
        {
            line[r] = board[r][c]; //this copies the numbers from the column into the temporary array
        }

        if (process_line(line, score)) // copy it into process line
        {
            changed = true;
        }

        // Put the column back.
        for (int r = 0; r < numrows; r++)
        {
            board[r][c] = line[r]; //move up takes one column at a time and moves its numbers towards the top
        }
    }

    return changed;
}


// MOVE DOWN
bool move_down(int board[][5], int numrows, int& score)
{
    bool changed = false;

    for (int c = 0; c < 5; c++) 
    {
        int line[5]; //temp array

        // Read the column backwards.
        for (int r = 0; r < numrows; r++)
        {
            line[r] = board[numrows - 1 - r][c]; //this reads the column bottom to top
        }

        if (process_line(line, score)) // moves the numbers together and combines matching numbers
        {
            changed = true;
        }

        // Put the column back backwards.
        for (int r = 0; r < numrows; r++)
        {
            board[numrows - 1 - r][c] = line[r];
        }
    }

    return changed;
}

//void doesn't return an answer

void print_board(int board[][5], int numrows = 5) // displays the game board on the screen
{
	cout << endl << "\t-----------------------------------------" << endl;

	for (int r = 0; r < numrows; r++) // tells the computer to look at every row
	{
		for (int c = 0; c < 5; c++) //goes through each column
		{
			if(board[r][c] > 0) // does this space contain a number great than 0?
				cout << "\t|" << right << setw(2) << setfill(' ') << board[r][c]; //yes       //| cout | Displays information. |
																						      //| "\t|" | Adds spacing and a vertical line. |
																							  //| right | Aligns the number to the right. |
																							  //| setw(2) | Gives the number two character spaces. |
																							  //| setfill(' ') | Uses spaces to fill extra room. |
																							  //| board[r][c] | Displays the actual number. |
			else
				cout << "\t|" << right << setw(2) << setfill('0') << " "; // if the space does not contain a number, do this instead
                                                                          // it prints an empty looking space
			//cout << board[r][c] << "\t|\t";
		}
		cout << "\t|" << endl;
		cout << "\t-----------------------------------------" << endl; //prints the rightside border and another horizontal line to seperate rows
	}

	cout << "\t" << endl << endl; // adds extra spacing after the board
}


void insert_random(int board[][5], int numrows = 5) // this function adds a new tile into the game
//find an empty spot on the board and randomly place a new number 2 there
{
	int r, c;
	//count empty
	int empty_count = 0; // count empty spaces
	for (int r = 0; r < numrows; r++) 
	{
		for (int c = 0; c < 5; c++)
		{
			if (board[r][c] == 0) // looks for zeros
				empty_count++; //everytime it finds a zero it adds one
		}
	}

	if (empty_count > 0) //are there any empty spaces left? if yes, continue. if no, do nothing
	{
		while (true) // tell the computer to keep trying until it finds an empty spot
		{
			//generate random location r, c
			r = rand() % numrows; 	//select
			c = rand() % numrows; 	//select
			//check if empty
			if (board[r][c] == 0) // check if the location is empty
			{
				//add number randomly {2,4}
				board[r][c] = 2;
				break; //stops the while loop because the computer successfully placed the new number
			}


            //start a new game with two 2's
			void new_game(int board[][5], int numrows = 5)
			{
			    // this clears every space on the board.
			    for (int r = 0; r < numrows; r++)
			    {
			        for (int c = 0; c < 5; c++)
			        {
			            board[r][c] = 0; 
			        }
			    }
			
			    // Add two starting tiles.
			    insert_random(board, numrows); //places 2 in an empty space
			    insert_random(board, numrows); //places 2 in an empty space
			}			


		//count the highest tile
		int highest_tile(int board[][5], int numrows = 5)
		{
		    int highest = 0; //start by assuming the highest number is zero
		
		    for (int r = 0; r < numrows; r++)
		    {
		        for (int c = 0; c < 5; c++)
		        {
		            if (board[r][c] > highest) //ask whether the current number is bigger than the highest number we have found
		            {
		                highest = board[r][c]; //if it is bigger, save that number
		            }
		        }
		    }
		
		    return highest; //give the highest number back to the main program
		}


////detect when the player reaches 2048
			bool check_win(int board[][5], int numrows = 5)
			{
			    for (int r = 0; r < numrows; r++)
			    {
			        for (int c = 0; c < 5; c++)
			        {
			            if (board[r][c] >= 2048) //checks every space to see if the player reached 2048
			            {
			                return true; //if it finds 2048 it tells the program yes 
			            }
			        }
			    }
			
			    return false;
			}













		}

	}
}
