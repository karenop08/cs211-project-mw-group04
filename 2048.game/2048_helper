// This function adds a new tile into the game.
// It finds an empty spot and randomly places a 2 there.
void insert_random(int board[][5], int numrows = 5)
{
    int empty_count = 0; // Counts empty spaces.

    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            if (board[r][c] == 0)
            {
                empty_count++;
            }
        }
    }

    // If there is at least one empty space, place a new tile.
    if (empty_count > 0)
    {
        while (true)
        {
            int r = rand() % numrows; // Selects a random row.
            int c = rand() % 5;       // Selects a random column.

            if (board[r][c] == 0)
            {
                board[r][c] = 2; // Adds a 2 to the empty space.
                break;            // Stops after successfully placing the tile.
            }
        }
    }
} // This brace closes insert_random before the next function begins.

// Start a new game with two 2s and reset the score and move count.
void new_game(int board[][5], int& score, int& moves, int numrows = 5)
{
    // This clears every space on the board.
    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            board[r][c] = 0;
        }
    }

    score = 0;
    moves = 0;

    // Add two starting tiles.
    insert_random(board, numrows);
    insert_random(board, numrows);
}

// Count the highest tile on the board.
int highest_tile(int board[][5], int numrows = 5)
{
    int highest = 0; // Starts by assuming the highest number is zero.
    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            if (board[r][c] > highest)
            {
                highest = board[r][c];
            }
        }
    }
    return highest;
}

// Detect when the player reaches 2048.
bool check_win(int board[][5], int numrows = 5)
{
    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            if (board[r][c] >= 2048)
            {
                return true;
            }
        }
    }
    return false;
}

// Detect when the game is over.
// The game is over when there are no empty spaces and no matching
// numbers next to each other horizontally or vertically.
bool game_over(int board[][5], int numrows = 5)
{
    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            // Check for an empty space.
            if (board[r][c] == 0)
            {
                return false;
            }

            // Check the number to the right.
            if (c < 4 && board[r][c] == board[r][c + 1])
            {
                return false;
            }

            // Check the number below.
            if (r < numrows - 1 && board[r][c] == board[r + 1][c])
            {
                return false;
            }
        }
    }
    return true;
}

// SAVE THE GAME
bool save_game(int board[][5], int score, int moves, int numrows = 5)
{
    ofstream file("savegame.txt"); // Creates a file called savegame.txt.
    if (!file)
    {
        return false;
    }

    file << score << endl; // Saves the score.
    file << moves << endl; // Saves the number of moves.

    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            file << board[r][c] << " "; // Saves every number on the board.
        }
        file << endl;
    }

    file.close(); // Closes the file after saving.
    return !file.fail(); // True means the save completed successfully.
}

// LOAD THE SAVED GAME
// ifstream opens a file to read information.
// saved_score holds the saved score; saved_moves holds the saved move count.
// saved_board temporarily holds the saved board.
// return false means something went wrong; true means the game loaded.
bool load_game(int board[][5], int& score, int& moves, int numrows = 5)
{
    ifstream file("savegame.txt");
    if (!file)
    {
        return false;
    }

    int saved_score;
    int saved_moves;
    int saved_board[5][5];

    if (!(file >> saved_score >> saved_moves))
    {
        return false;
    }

    if (saved_score < 0 || saved_moves < 0)
    {
        return false;
    }

    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            if (!(file >> saved_board[r][c]))
            {
                return false;
            }

            int value = saved_board[r][c];
            // A tile must be zero or a power of two of at least 2.
            if (value < 0 || (value != 0 && (value < 2 || (value & (value - 1)) != 0)))
            {
                return false;
            }
        }
    }

    // Only update the current game after the entire saved game passes validation.
    score = saved_score;
    moves = saved_moves;
    for (int r = 0; r < numrows; r++)
    {
        for (int c = 0; c < 5; c++)
        {
            board[r][c] = saved_board[r][c];
        }
    }

    file.close();
    return true;
}

