// This function moves numbers together and combines matching tiles.
// line[5] means we are working with five numbers in one row or column.
// int& score means this function can update the player's score.
bool process_line(int line[5], int& score)
{
    int original[5]; // Holds a copy of the original five numbers.

    // Save the original line so we can compare it later.
    for (int i = 0; i < 5; i++)
    {
        original[i] = line[i];
    }

    int temp[5] = {0, 0, 0, 0, 0}; // Temporary spaces for arranging numbers.
    int position = 0; // Tells the computer where to put the next number.

    // Step 1: Move all nonzero numbers together.
    // This removes the empty spaces between numbers.
    for (int i = 0; i < 5; i++)
    {
        if (line[i] != 0)
        {
            temp[position] = line[i];
            position++;
        }
    }

    // Step 2: Combine matching numbers.
    for (int i = 0; i < 4; i++) // Checks positions 0 through 3.
    {
        if (temp[i] != 0 && temp[i] == temp[i + 1])
        {
            temp[i] = temp[i] * 2;
            score += temp[i]; // Add the new tile value to the score.
            temp[i + 1] = 0;  // Clear the tile that was combined.
            i++;              // Skip the newly combined tile.
        }
    }

    // Step 3: Move numbers together again after merging.
    int result[5] = {0, 0, 0, 0, 0};
    position = 0;

    for (int i = 0; i < 5; i++)
    {
        if (temp[i] != 0)
        {
            result[position] = temp[i];
            position++;
        }
    }

    // Check whether anything actually changed.
    bool changed = false;
    for (int i = 0; i < 5; i++)
    {
        line[i] = result[i];
        if (original[i] != result[i])
        {
            changed = true;
        }
    }

    return changed;
}

// MOVE LEFT
bool move_left(int board[][5], int numrows, int& score)
{
    bool changed = false;
    for (int r = 0; r < numrows; r++)
    {
        if (process_line(board[r], score)) // Moves each row to the left.
        {
            changed = true;
        }
    }
    return changed;
}

// MOVE RIGHT
bool move_right(int board[][5], int numrows, int& score)
{
    bool changed = false;
    for (int r = 0; r < numrows; r++)
    {
        int line[5]; // Temporary row to hold five numbers.

        // Read the row backwards.
        for (int c = 0; c < 5; c++)
        {
            line[c] = board[r][4 - c];
        }

        if (process_line(line, score))
        {
            changed = true;
        }

        // Put the row back backwards.
        for (int c = 0; c < 5; c++)
        {
            board[r][4 - c] = line[c];
        }
    }
    return changed;
}

// MOVE UP
bool move_up(int board[][5], int numrows, int& score)
{
    bool changed = false;
    for (int c = 0; c < 5; c++) // Checks each of the five columns.
    {
        int line[5]; // Temporary array to hold one column.

        // Read the column from top to bottom.
        for (int r = 0; r < numrows; r++)
        {
            line[r] = board[r][c];
        }

        if (process_line(line, score))
        {
            changed = true;
        }

        // Put the column back.
        for (int r = 0; r < numrows; r++)
        {
            board[r][c] = line[r];
        }
    }
    return changed;
}

// MOVE DOWN
bool move_down(int board[][5], int numrows, int& score)
{
    bool changed = false;
    for (int c = 0; c < 5; c++)
    {
        int line[5]; // Temporary array.

        // Read the column backwards, from bottom to top.
        for (int r = 0; r < numrows; r++)
        {
            line[r] = board[numrows - 1 - r][c];
        }

        if (process_line(line, score))
        {
            changed = true;
        }

        // Put the column back backwards.
        for (int r = 0; r < numrows; r++)
        {
            board[numrows - 1 - r][c] = line[r];
        }
    }
    return changed;
}

